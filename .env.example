# Copy this file to `.env` and uncomment ONE provider block below.
# The npm scripts load `.env` automatically (Node --env-file).
# With nothing set, the app runs the built-in offline responder.
#
# Provider selection order in chat.js:
#   1. OPENAI_BASE_URL set  -> OpenAI-compatible provider (Gemini, Groq, Ollama…)
#   2. ANTHROPIC_API_KEY set -> Anthropic (Claude)
#   3. neither               -> offline fallback

# --- Google Gemini (free tier; OpenAI-compatible endpoint) -------------------
# Get a key: https://aistudio.google.com/apikey
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_API_KEY=your-gemini-key-here
OPENAI_MODEL=gemini-flash-latest

# --- Groq (free tier; very fast) ---------------------------------------------
# Get a key: https://console.groq.com/keys
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=your-groq-key-here
# OPENAI_MODEL=llama-3.3-70b-versatile

# --- Ollama (fully local, free, no key; requires `ollama serve`) -------------
# Install: https://ollama.com  then `ollama pull llama3.2`
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.2

# --- Anthropic (Claude) ------------------------------------------------------
# Leave OPENAI_BASE_URL unset (comment it out) to use this instead.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Local LLM fallback (free, offline) --------------------------------------
# When the primary provider above is rate-limited or errors, the app retries a
# local model over a local OpenAI-compatible server, before showing the
# "catching its breath" message. Enabled by default.
#   LM Studio: start its Local Server (Developer tab) — default URL below.
#   Ollama:    run `ollama serve` and set LOCAL_LLM_URL=http://localhost:11434/v1
# Model is auto-detected from the loaded model unless you set LOCAL_LLM_MODEL.
# LOCAL_LLM_URL=http://localhost:1234/v1
# LOCAL_LLM_MODEL=
# LOCAL_LLM_FALLBACK=0    # set to 0 to disable the local fallback
# LOCAL_LLM_AUTOSTART=0   # set to 0 to NOT auto-start LM Studio when it's down
# LMS_PATH=/custom/path/to/lms   # override LM Studio CLI location if needed

# --- Server ------------------------------------------------------------------
# PORT=3001
# HOST=0.0.0.0    # default: shareable on your LAN. Use 127.0.0.1 to lock to this machine.
